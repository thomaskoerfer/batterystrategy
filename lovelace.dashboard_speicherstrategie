              "span": {
                "start": "day",
                "offset": "+1d"
              }
            },
            {
              "type": "custom:apexcharts-card",
              "header": {
                "show": true,
                "title": "Hauslast ohne EV: Forecast vs Ist (48h, stündlich Balken)"
              },
              "graph_span": "48h",
              "span": {
                "start": "day"
              },
              "series": [
                {
                  "entity": "sensor.battery_strategy_dryrun",
                  "name": "Ist (W)",
                  "type": "column",
                  "color": "#2e86de",
                  "opacity": 0.45,
                  "data_generator": "const src=entity.attributes.profile_48h_house_actual_power||[]; const b={}; for(const p of src){const h=Math.floor(p[0]/3600000)*3600000; (b[h]=b[h]||[]).push(p[1]);} return Object.keys(b).map(k=>[Number(k), b[k].reduce((a,v)=>a+v,0)/b[k].length]).sort((a,b)=>a[0]-b[0]);"
                },
                {
                  "entity": "sensor.battery_strategy_dryrun",
                  "name": "Forecast (W)",
                  "type": "column",
                  "color": "#f39c12",
                  "opacity": 0.45,
                  "data_generator": "const src=entity.attributes.profile_48h_house_fc_power||[]; const b={}; for(const p of src){const h=Math.floor(p[0]/3600000)*3600000; (b[h]=b[h]||[]).push(p[1]);} return Object.keys(b).map(k=>[Number(k), b[k].reduce((a,v)=>a+v,0)/b[k].length]).sort((a,b)=>a[0]-b[0]);"
                }
              ],
              "yaxis": [
                {
                  "min": 0,
                  "decimals": 0,
                  "apex_config": {
                    "forceNiceScale": true
                  }
                }
              ],
              "apex_config": {
                "plotOptions": {
                  "bar": {
                    "columnWidth": "92%"
                  }
                },
                "chart": {
                  "stacked": false
                }
              }
