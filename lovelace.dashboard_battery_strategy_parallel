                      "type": "line",
                      "color": "#e74c3c",
                      "stroke_width": 1,
                      "opacity": 0.9,
                      "curve": "straight",
                      "yaxis_id": "soc",
                      "data_generator": "return entity.attributes.soc || [];"
                    }
                  ]
                }
              ]
            },
            {
              "type": "grid",
              "column_span": 2,
              "cards": [
                {
                  "type": "custom:apexcharts-card",
                  "header": {
                    "show": true,
                    "title": "Battery Strategy: PV, Hauslast und Plan-Residual (48h)"
                  },
                  "graph_span": "48h",
                  "span": {
                    "start": "day"
                  },
                  "yaxis": [
                    {
                      "min": 0,
                      "decimals": 0,
                      "apex_config": {
                        "forceNiceScale": true
                      }
                    }
                  ],
                  "series": [
                    {
                      "entity": "sensor.battery_strategy_hacs_profile_48h",
                      "name": "PV Forecast (W)",
                      "type": "line",
                      "color": "#f39c12",
                      "stroke_width": 2,
                      "extend_to": false,
                      "data_generator": "return entity.attributes.pv_fc_power || [];"
                    },
                    {
                      "entity": "sensor.battery_strategy_hacs_profile_48h",
                      "name": "PV Ist (W)",
                      "type": "line",
                      "color": "#f39c12",
                      "stroke_width": 1,
                      "opacity": 0.55,
                      "extend_to": false,
                      "data_generator": "return entity.attributes.pv_actual_power || [];"
                    },
                    {
                      "entity": "sensor.battery_strategy_hacs_profile_48h",
                      "name": "Hauslast Forecast ohne EV (W)",
                      "type": "line",
                      "color": "#2e86de",
                      "stroke_width": 2,
                      "extend_to": false,
                      "data_generator": "return entity.attributes.house_fc_power || [];"
