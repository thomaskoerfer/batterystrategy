                        "opposite": true
                      }
                    }
                  ],
                  "series": [
                    {
                      "entity": "sensor.battery_strategy_hacs_profile_today",
                      "name": "Preis (ct/kWh)",
                      "type": "line",
                      "color": "#f39c12",
                      "stroke_width": 2,
                      "yaxis_id": "price",
                      "data_generator": "return entity.attributes.price || [];"
                    },
                    {
                      "entity": "sensor.battery_strategy_hacs_soc",
                      "name": "SoC Ist (%)",
                      "type": "line",
                      "color": "#2e86de",
                      "stroke_width": 3,
                      "yaxis_id": "soc",
                      "extend_to": false,
                      "show": {
                        "in_header": false
                      }
                    },
                    {
                      "entity": "sensor.battery_strategy_hacs_profile_today",
                      "name": "SoC Plan Resttag (%)",
                      "type": "line",
                      "color": "#e74c3c",
                      "stroke_width": 1,
                      "opacity": 0.9,
                      "curve": "straight",
                      "yaxis_id": "soc",
                      "data_generator": "const now=Date.now(); return (entity.attributes.soc || []).filter(p=>p[0]>=now);"
                    }
                  ]
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:apexcharts-card",
