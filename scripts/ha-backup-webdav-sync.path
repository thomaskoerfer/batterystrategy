[Unit]
Description=Watch HA backup directory for new backups

[Path]
PathExistsGlob=/var/lib/docker/volumes/homeassistant_config/_data/backups/*.tar
PathModified=/var/lib/docker/volumes/homeassistant_config/_data/backups
PathChanged=/var/lib/docker/volumes/homeassistant_config/_data/backups
Unit=ha-backup-webdav-sync.service

[Install]
WantedBy=multi-user.target
