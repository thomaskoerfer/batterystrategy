{
  "version": 1,
  "minor_version": 2,
  "key": "lovelace.dashboard_speicherstrategie",
  "data": {
    "config": {
      "title": "Speicherstrategie",
      "views": [
        {
          "path": "overview",
          "title": "Betrieb",
          "badges": [],
          "cards": [
            {
              "type": "entities",
              "title": "Live Empfehlung (Kompakt)",
              "entities": [
                "input_boolean.battery_strategy_kill_switch",
                "input_boolean.battery_strategy_suppress_charge_grid",
                "input_boolean.battery_strategy_full_discharge",
                "sensor.battery_strategy_mode",
                "sensor.battery_strategy_live_command_mode",
                "sensor.battery_strategy_live_command_power",
                "sensor.battery_strategy_live_command_override_reason",
                "sensor.battery_strategy_recommended_power",
                "sensor.battery_strategy_residual_net_no_battery_no_ev",
                "sensor.battery_strategy_grid_net_actual_power_now",
                "sensor.battery_strategy_house_load_actual_power_now",
                "sensor.heerlener_strasse_300_aktueller_strompreis",
                "sensor.battery_strategy_simulated_soc"
              ],
              "show_header_toggle": false
            },
            {
              "type": "entities",
              "title": "Kosten (Planung)",
              "entities": [
                "sensor.battery_strategy_baseline_cost_today",
                "sensor.battery_strategy_optimized_cost_today",
                "sensor.battery_strategy_savings_today_calc",
                "sensor.battery_strategy_baseline_cost_tomorrow",
                "sensor.battery_strategy_optimized_cost_tomorrow",
                "sensor.battery_strategy_savings_tomorrow_calc",
                "sensor.battery_strategy_estimated_savings_cumulative"
              ]
            },
            {
              "type": "entities",
              "title": "Kosten (Ist Batterie)",
              "entities": [
                "sensor.battery_strategy_actual_savings_today",
                "sensor.battery_strategy_actual_savings_cumulative",
                {
                  "type": "divider"
                },
                "sensor.battery_strategy_actual_charge_total_today",
                "sensor.battery_strategy_actual_charge_grid_today",
                "sensor.battery_strategy_actual_charge_pv_today",
                "sensor.battery_strategy_actual_avg_charge_price_today",
                {
                  "type": "divider"
                },
                "sensor.battery_strategy_actual_discharge_credited_today",
                "sensor.battery_strategy_actual_avg_discharge_price_today"
              ]
            },
            {
              "type": "custom:apexcharts-card",
              "header": {
                "show": true,
                "title": "Batterieprofil Heute (Preis + SoC Ist/Plan)"
              },
              "graph_span": "24h",
              "yaxis": [
                {
                  "id": "price",
                  "min": 0
                },
                {
                  "id": "soc",
                  "min": 0,
                  "max": 100
                }
              ],
              "series": [
                {
                  "entity": "sensor.battery_strategy_dryrun",
                  "name": "Preis (ct/kWh)",
                  "type": "line",
                  "color": "#f39c12",
                  "stroke_width": 2,
                  "yaxis_id": "price",
                  "data_generator": "return entity.attributes.profile_today_price || [];"
                },
                {
                  "entity": "sensor.battery_strategy_simulated_soc",
                  "name": "SoC Ist (%)",
                  "type": "line",
                  "color": "#2e86de",
                  "stroke_width": 3,
                  "yaxis_id": "soc",
                  "extend_to": false,
                  "show": {
                    "in_header": false
                  }
                },
                {
                  "entity": "sensor.battery_strategy_dryrun",
                  "name": "SoC Plan Resttag (%)",
                  "type": "line",
                  "color": "#e74c3c",
                  "stroke_width": 1,
                  "opacity": 0.9,
                  "curve": "straight",
                  "yaxis_id": "soc",
                  "data_generator": "const now=Date.now(); const raw=(entity.attributes.profile_today_soc||[]).filter(p=>p[0]>=now); const s=hass && hass.states && hass.states['sensor.battery_strategy_simulated_soc'] ? parseFloat(hass.states['sensor.battery_strategy_simulated_soc'].state) : NaN; if(!raw.length||isNaN(s)) return raw; const shift=s-raw[0][1]; return raw.map((p)=>[p[0], Math.max(0, Math.min(100, p[1]+shift))]);"
                }
              ],
              "span": {
                "start": "day"
              }
            },
            {
              "type": "custom:apexcharts-card",
              "header": {
                "show": true,
                "title": "Batterieprofil Morgen (Preis + SoC Plan)"
              },
              "graph_span": "24h",
              "yaxis": [
                {
                  "id": "price",
                  "min": 0
                },
                {
                  "id": "soc",
                  "min": 0,
                  "max": 100
                }
              ],
              "series": [
                {
                  "entity": "sensor.battery_strategy_dryrun",
                  "name": "Preis (ct/kWh)",
                  "type": "line",
                  "color": "#f39c12",
                  "stroke_width": 2,
                  "yaxis_id": "price",
                  "data_generator": "return entity.attributes.profile_tomorrow_price || [];"
                },
                {
                  "entity": "sensor.battery_strategy_dryrun",
                  "name": "SoC Plan (%)",
                  "type": "line",
                  "color": "#e74c3c",
                  "stroke_width": 1,
                  "opacity": 0.9,
                  "curve": "straight",
                  "yaxis_id": "soc",
                  "data_generator": "return entity.attributes.profile_tomorrow_soc || [];"
                }
              ],
              "span": {
                "start": "day",
                "offset": "+1d"
              }
            },
            {
              "type": "custom:apexcharts-card",
              "header": {
                "show": true,
                "title": "Hauslast ohne EV: Forecast vs Ist (48h, stündlich Balken)"
              },
              "graph_span": "48h",
              "span": {
                "start": "day"
              },
              "series": [
                {
                  "entity": "sensor.battery_strategy_dryrun",
                  "name": "Ist (W)",
                  "type": "column",
                  "color": "#2e86de",
                  "opacity": 0.45,
                  "data_generator": "const src=entity.attributes.profile_48h_house_actual_power||[]; const b={}; for(const p of src){const h=Math.floor(p[0]/3600000)*3600000; (b[h]=b[h]||[]).push(p[1]);} return Object.keys(b).map(k=>[Number(k), b[k].reduce((a,v)=>a+v,0)/b[k].length]).sort((a,b)=>a[0]-b[0]);"
                },
                {
                  "entity": "sensor.battery_strategy_dryrun",
                  "name": "Forecast (W)",
                  "type": "column",
                  "color": "#f39c12",
                  "opacity": 0.45,
                  "data_generator": "const src=entity.attributes.profile_48h_house_fc_power||[]; const b={}; for(const p of src){const h=Math.floor(p[0]/3600000)*3600000; (b[h]=b[h]||[]).push(p[1]);} return Object.keys(b).map(k=>[Number(k), b[k].reduce((a,v)=>a+v,0)/b[k].length]).sort((a,b)=>a[0]-b[0]);"
                }
              ],
              "yaxis": [
                {
                  "min": 0,
                  "decimals": 0,
                  "apex_config": {
                    "forceNiceScale": true
                  }
                }
              ],
              "apex_config": {
                "plotOptions": {
                  "bar": {
                    "columnWidth": "92%"
                  }
                },
                "chart": {
                  "stacked": false
                }
              }
            },
            {
              "type": "custom:apexcharts-card",
              "header": {
                "show": true,
                "title": "Solar Forecast vs Ist (48h)"
              },
              "graph_span": "48h",
              "span": {
                "start": "day"
              },
              "series": [
                {
                  "entity": "sensor.battery_strategy_dryrun",
                  "name": "Forecast Solarleistung (W)",
                  "type": "line",
                  "color": "#f39c12",
                  "stroke_width": 2,
                  "extend_to": false,
                  "data_generator": "return entity.attributes.profile_48h_pv_fc_power || [];"
                },
                {
                  "entity": "sensor.battery_strategy_dryrun",
                  "name": "Ist Solarleistung (W)",
                  "type": "line",
                  "color": "#2e86de",
                  "stroke_width": 2,
                  "extend_to": false,
                  "data_generator": "return entity.attributes.profile_48h_pv_actual_power || [];"
                }
              ]
            }
          ]
        },
        {
          "path": "debug",
          "title": "Debug",
          "badges": [],
          "cards": [
            {
              "type": "entities",
              "title": "Forecast Qualitaet",
              "entities": [
                "sensor.battery_strategy_script_version",
                "sensor.battery_strategy_pv_bias",
                "sensor.battery_strategy_load_bias",
                "sensor.battery_strategy_pv_bias_slot_now",
                "sensor.battery_strategy_load_bias_slot_now",
                "sensor.battery_strategy_backtest_mae_pv_24h",
                "sensor.battery_strategy_backtest_mae_load_24h",
                "sensor.battery_strategy_backtest_mae_pv_7d",
                "sensor.battery_strategy_backtest_mae_load_7d",
                "sensor.battery_strategy_backtest_hit_rate_24h"
              ]
            },
            {
              "type": "entities",
              "title": "Entlade Diagnose",
              "entities": [
                "sensor.battery_strategy_mode",
                "sensor.battery_strategy_planned_power",
                "sensor.battery_strategy_required_discharge_power",
                "sensor.battery_strategy_remaining_discharge_budget",
                "sensor.battery_strategy_slot_value_score"
              ]
            },
            {
              "type": "entities",
              "title": "Preisbeobachtung",
              "entities": [
                "sensor.battery_strategy_price_slot_median_ct",
                "sensor.battery_strategy_price_slot_q20_ct",
                "sensor.battery_strategy_price_slot_q80_ct",
                "sensor.battery_strategy_price_slot_rank",
                "sensor.battery_strategy_price_tomorrow_min_ct",
                "sensor.battery_strategy_price_tomorrow_min_rank",
                "sensor.battery_strategy_eex_base_tomorrow_ct",
                "sensor.battery_strategy_eex_peak_tomorrow_ct",
                "sensor.battery_strategy_eex_spread_tomorrow_ct",
                "sensor.battery_strategy_eex_base_day_after_ct",
                "sensor.battery_strategy_eex_peak_day_after_ct",
                "sensor.battery_strategy_eex_spread_day_after_ct"
              ]
            }
          ]
        }
      ]
    }
  }
}
