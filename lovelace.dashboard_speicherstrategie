                  "color": "#f39c12",
                  "stroke_width": 2,
                  "yaxis_id": "price",
                  "data_generator": "return entity.attributes.profile_today_price || [];"
                },
                {
                  "entity": "sensor.battery_strategy_simulated_soc",
                  "name": "SoC Ist (%)",
                  "type": "line",
                  "color": "#2e86de",
                  "stroke_width": 3,
                  "yaxis_id": "soc",
                  "extend_to": false,
                  "show": {
                    "in_header": false
                  }
                },
                {
                  "entity": "sensor.battery_strategy_dryrun",
                  "name": "SoC Plan Resttag (%)",
                  "type": "line",
                  "color": "#e74c3c",
                  "stroke_width": 1,
                  "opacity": 0.9,
                  "curve": "straight",
                  "yaxis_id": "soc",
                  "data_generator": "const now=Date.now(); const raw=(entity.attributes.profile_today_soc||[]).filter(p=>p[0]>=now); const s=hass && hass.states && hass.states['sensor.battery_strategy_simulated_soc'] ? parseFloat(hass.states['sensor.battery_strategy_simulated_soc'].state) : NaN; if(!raw.length||isNaN(s)) return raw; const shift=s-raw[0][1]; return raw.map((p)=>[p[0], Math.max(0, Math.min(100, p[1]+shift))]);"
                }
              ],
              "span": {
                "start": "day"
              }
            },
            {
              "type": "custom:apexcharts-card",
              "header": {
                "show": true,
                "title": "Batterieprofil Morgen (Preis + SoC Plan)"
